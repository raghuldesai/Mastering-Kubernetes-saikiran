Installing certbot

sudo snap install --classic certbot

Run below command to generate certificate

certbot certonly --manual --preferred-challenges=dns --key-type rsa --email devopsformee@gmail.com --server https://acme-v02.api.letsencrypt.org/directory --agree-tos -d *.devopsformee.xyz


root@ip-172-31-82-131:~# certbot certonly --manual --preferred-challenges=dns --key-type rsa --email devopsformee@gmail.com --server https://acme-v02.api.letsencrypt.org/directory --agree-tos -d *.devopsformee.xyz
